# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# These values identify the project to the browser. They are not secrets, but keep .env.local out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check: the reCAPTCHA Enterprise site key registered for this web app.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Development only. Leave empty to have the SDK print a new debug token in the console,
# then register that token in Firebase console > App Check > Apps > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
